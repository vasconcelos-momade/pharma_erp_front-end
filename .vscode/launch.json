{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "pharma_erp (Linux desktop)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "deviceId": "linux",
      "toolArgs": ["--no-pub"]
    },
    {
      "name": "pharma_erp (Web — Chrome, port 5000)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "deviceId": "chrome",
      "toolArgs": ["--no-pub", "--web-port=5000"],
      "env": {
        "CHROME_EXECUTABLE": "/usr/bin/google-chrome"
      }
    }
  ]
}
